# Bharosa Frontend Environment Variables (Vite + React 18)

VITE_APP_NAME="Bharosa"
VITE_DEMO_MODE=true

# API Backend Service (Proxy or Direct)
VITE_API_URL=/v1

# Blockchain RPC Node & Chain ID (Local Hardhat 31337 / Polygon Amoy 80002)
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
VITE_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
VITE_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# IPFS Gateway
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/

# WalletConnect Project ID for Web3 Wallets
VITE_WALLETCONNECT_PROJECT_ID=3fcc6bba0f1de962dcbdae11bd9cee4d
