# Bharosa Frontend Environment Variables (Local Defaults - No edits needed)

NEXT_PUBLIC_APP_NAME="Bharosa"
NEXT_PUBLIC_DEMO_MODE=true

# API Backend Helper Service
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

# Blockchain RPC Node & Chain ID (Local Hardhat 31337 / Polygon Amoy 80002)
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# IPFS Gateway
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Optional WalletConnect Project ID for Mobile Wallets
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=3fcc6bba0f1de962dcbdae11bd9cee4d
