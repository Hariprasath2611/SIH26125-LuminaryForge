{
  "name": "bharosa-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Bharosa backend helper & security indexing service (Node 20 + Express + TypeScript)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "backend": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "reindex": "tsx src/workers/indexer.ts --reindex",
    "copilot:index": "tsx src/scripts/index-kb.ts",
    "seed:demo": "tsx src/scripts/seed.ts",
    "test": "vitest run",
    "lint": "eslint src/ --ext .ts"
  },
  "dependencies": {
    "@prisma/client": "^5.15.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "bullmq": "^5.8.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "1.4.5-lts.1",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0",
    "prisma": "^5.15.1",
    "siwe": "^2.3.2",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^11.2.0",
    "supertest": "^7.0.0",
    "vitest": "^1.6.0"
  }
}
