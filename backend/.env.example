# Bharosa Backend Environment Variables (Local Defaults - No edits needed)

PORT=3001
NODE_ENV=development
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:3000,https://bharosa.vercel.app
DEMO_MODE=true

# Database and Redis (Fallback to in-memory store in DEMO_MODE)
DATABASE_URL=postgresql://bharosa_user:bharosa_password@localhost:5432/bharosa_db?schema=public
REDIS_URL=redis://localhost:6379

# SIWE Authentication & JWT Secrets
JWT_SECRET=bharosa_super_secure_jwt_secret_key_minimum_32_characters_siwe_auth
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=bharosa_super_secure_refresh_secret_key_rotation_token_32_chars
REFRESH_TOKEN_EXPIRY=7d
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000

# Blockchain RPC Node & Gasless Relayer Key
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Optional Pinata IPFS JWT for testnet/cloud pinning
PINATA_JWT=
