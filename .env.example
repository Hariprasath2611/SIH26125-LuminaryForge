# ==============================================================================
# BHAROSA (भरोसा) - Enterprise Environment Configuration Template
# Sovereign Identity, ABAC Access Control & Sovereign Asset Management
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND APP (React 18 + Vite)
# ------------------------------------------------------------------------------
VITE_APP_NAME="Bharosa"
VITE_CHAIN_ID=31337
VITE_RPC_URL="http://127.0.0.1:8545"
VITE_API_URL="http://localhost:4000/v1"
VITE_IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs/"
VITE_LOCAL_IPFS_GATEWAY="http://127.0.0.1:8080/ipfs/"
VITE_WALLETCONNECT_PROJECT_ID="3fcc6bba0f1de962dcbdae11bd9cee4d"

# Deployed Contract Addresses (Updated automatically during deploy:local / deploy:testnet)
VITE_CONTRACT_IDENTITY_REGISTRY="0x5FbDB2315678afecb367f032d93F642f64180aa3"
VITE_CONTRACT_ACCESS_CONTROL="0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512"
VITE_CONTRACT_OWNERSHIP_REGISTRY="0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0"
VITE_CONTRACT_SOCIAL_RECOVERY="0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9"
VITE_CONTRACT_ZK_VERIFIER="0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9"
VITE_CONTRACT_AUDIT_ANCHOR="0x5FC8d32690cc91D4c39d9d3abcBD16989F875707"

# ------------------------------------------------------------------------------
# 2. BACKEND API & WORKERS (apps/api)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV="development"
API_PREFIX="/v1"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database & Cache
DATABASE_URL="postgresql://bharosa_user:bharosa_password@localhost:5432/bharosa_db?schema=public"
REDIS_URL="redis://localhost:6379"

# Security & Sessions (SIWE + JWT)
JWT_SECRET="bharosa_super_secure_jwt_secret_key_minimum_32_characters_siwe_auth"
JWT_EXPIRY="15m"
REFRESH_TOKEN_SECRET="bharosa_super_secure_refresh_secret_key_rotation_token_32_chars"
REFRESH_TOKEN_EXPIRY="7d"
SIWE_DOMAIN="localhost:3000"
SIWE_URI="http://localhost:3000"

# Storage: Pinata IPFS (Production) & Local Kubo Node (Dev fallback)
PINATA_API_KEY=""
PINATA_API_SECRET=""
PINATA_JWT=""
PINATA_GATEWAY="https://gateway.pinata.cloud/ipfs/"
IPFS_NODE_API_URL="http://127.0.0.1:5001"
IPFS_NODE_GATEWAY_URL="http://127.0.0.1:8080/ipfs/"

# Blockchain RPC & Relayer
RPC_URL="http://127.0.0.1:8545"
RPC_FALLBACK_URL=""
CHAIN_ID=31337
# Hardhat Account #0 default test key (NEVER use with real funds)
RELAYER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
AUDIT_ANCHOR_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
RELAYER_DAILY_GAS_CAP_WEI="1000000000000000000" # 1 ETH/MATIC
RELAYER_PER_DID_QUOTA_PER_DAY=50
RELAYER_PER_IP_QUOTA_PER_DAY=100

# EIP-4337 Account Abstraction
BUNDLER_RPC_URL="http://127.0.0.1:4337"
PAYMASTER_KEY=""

# Smart Contract Addresses for API Event Indexer & Anchor
CONTRACT_IDENTITY_REGISTRY="0x5FbDB2315678afecb367f032d93F642f64180aa3"
CONTRACT_ACCESS_CONTROL="0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512"
CONTRACT_OWNERSHIP_REGISTRY="0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0"
CONTRACT_SOCIAL_RECOVERY="0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9"
CONTRACT_ZK_VERIFIER="0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9"
CONTRACT_AUDIT_ANCHOR="0x5FC8d32690cc91D4c39d9d3abcBD16989F875707"

# ------------------------------------------------------------------------------
# 3. SMART CONTRACTS (packages/contracts)
# ------------------------------------------------------------------------------
HARDHAT_NETWORK="hardhat"
# Deployment deployer private key (Testnet / Local)
DEPLOYER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
POLYGON_AMOY_RPC_URL="https://rpc-amoy.polygon.technology"
ARBITRUM_SEPOLIA_RPC_URL="https://sepolia-rollup.arbitrum.io/rpc"
